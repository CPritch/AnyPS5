set(ANYPS5_PGO OFF CACHE STRING "Profile-guided optimization of the native libraries: OFF, GENERATE or USE")
set_property(CACHE ANYPS5_PGO PROPERTY STRINGS OFF GENERATE USE)
set(ANYPS5_PGO_DIR "" CACHE PATH "Directory of the .gcda profiles that ANYPS5_PGO=GENERATE writes and ANYPS5_PGO=USE reads")

if(NOT ANYPS5_PGO MATCHES "^(OFF|GENERATE|USE)$")
    message(FATAL_ERROR "ANYPS5_PGO must be OFF, GENERATE or USE, not ${ANYPS5_PGO}")
endif()

if(NOT ANYPS5_PGO STREQUAL "OFF")
    if(NOT CMAKE_SYSTEM_NAME STREQUAL "Linux")
        message(FATAL_ERROR "ANYPS5_PGO is supported only on Linux")
    endif()
    if(NOT CMAKE_CXX_COMPILER_ID STREQUAL "GNU" OR CMAKE_CXX_COMPILER_VERSION VERSION_LESS 11)
        message(FATAL_ERROR "ANYPS5_PGO requires GCC 11 or newer, not ${CMAKE_CXX_COMPILER_ID} ${CMAKE_CXX_COMPILER_VERSION}")
    endif()
    if(NOT IS_ABSOLUTE "${ANYPS5_PGO_DIR}")
        message(FATAL_ERROR "ANYPS5_PGO=${ANYPS5_PGO} needs ANYPS5_PGO_DIR, an absolute directory, not '${ANYPS5_PGO_DIR}'")
    endif()
    cmake_path(NORMAL_PATH ANYPS5_PGO_DIR OUTPUT_VARIABLE anyps5PgoDir)
    string(REGEX REPLACE "(.)/$" "\\1" anyps5PgoDir "${anyps5PgoDir}")
endif()

if(ANYPS5_PGO STREQUAL "GENERATE")
    set(ANYPS5_PGO_COMPILE_OPTIONS -fprofile-generate -fprofile-update=prefer-atomic "-fprofile-dir=${anyps5PgoDir}"
            "-fprofile-prefix-path=${CMAKE_BINARY_DIR}")
    set(ANYPS5_PGO_LINK_OPTIONS -fprofile-generate)
elseif(ANYPS5_PGO STREQUAL "USE")
    file(GLOB anyps5PgoProfiles "${anyps5PgoDir}/*.gcda")
    list(LENGTH anyps5PgoProfiles anyps5PgoProfileCount)
    if(anyps5PgoProfileCount EQUAL 0)
        message(FATAL_ERROR "ANYPS5_PGO=USE: no .gcda profiles in ${anyps5PgoDir}; train a build configured with ANYPS5_PGO=GENERATE first")
    endif()
    message(STATUS "ANYPS5_PGO=USE: ${anyps5PgoProfileCount} profiles in ${anyps5PgoDir}")
    set(ANYPS5_PGO_COMPILE_OPTIONS -fprofile-use -fprofile-partial-training -fprofile-correction "-fprofile-dir=${anyps5PgoDir}"
            "-fprofile-prefix-path=${CMAKE_BINARY_DIR}" -Wno-missing-profile -Wno-coverage-mismatch)
    set(ANYPS5_PGO_LINK_OPTIONS -fprofile-use -fprofile-partial-training)
endif()

set(ANYPS5_PGO_SOURCE_ROOT "${CMAKE_SOURCE_DIR}/core")
set(ANYPS5_PGO_EXCLUDED_ROOT "${CMAKE_SOURCE_DIR}/core/relinker")

function(anyps5_pgo_directories directory result)
    set(found "${directory}")
    get_property(subdirectories DIRECTORY "${directory}" PROPERTY SUBDIRECTORIES)
    foreach(subdirectory IN LISTS subdirectories)
        cmake_path(IS_PREFIX ANYPS5_PGO_SOURCE_ROOT "${subdirectory}" NORMALIZE inside)
        cmake_path(IS_PREFIX ANYPS5_PGO_EXCLUDED_ROOT "${subdirectory}" NORMALIZE excluded)
        if(inside AND NOT excluded)
            anyps5_pgo_directories("${subdirectory}" nested)
            list(APPEND found ${nested})
        endif()
    endforeach()
    set(${result} ${found} PARENT_SCOPE)
endfunction()

function(anyps5_apply_pgo)
    if(ANYPS5_PGO STREQUAL "OFF")
        return()
    endif()
    anyps5_pgo_directories("${CMAKE_SOURCE_DIR}" directories)
    list(REMOVE_ITEM directories "${CMAKE_SOURCE_DIR}")
    set(libraries 0)
    foreach(directory IN LISTS directories)
        get_property(targets DIRECTORY "${directory}" PROPERTY BUILDSYSTEM_TARGETS)
        foreach(target IN LISTS targets)
            get_target_property(type ${target} TYPE)
            if(type STREQUAL "SHARED_LIBRARY" OR type STREQUAL "MODULE_LIBRARY")
                target_compile_options(${target} PRIVATE ${ANYPS5_PGO_COMPILE_OPTIONS})
                target_link_options(${target} PRIVATE ${ANYPS5_PGO_LINK_OPTIONS})
                if(ANYPS5_PGO STREQUAL "GENERATE")
                    target_link_options(${target} PRIVATE LINKER:--exclude-libs,libgcov.a)
                    get_target_property(suffix ${target} SUFFIX)
                    if(target STREQUAL "libc")
                        target_sources(${target} PRIVATE "${CMAKE_SOURCE_DIR}/cmake/ProfileDumpRegistry.cpp")
                        target_link_options(${target} PRIVATE LINKER:--wrap=_Exit)
                    elseif(suffix STREQUAL ".prx")
                        target_sources(${target} PRIVATE "${CMAKE_SOURCE_DIR}/cmake/ProfileDump.cpp")
                        target_link_options(${target} PRIVATE LINKER:--wrap=_Exit)
                    endif()
                endif()
                math(EXPR libraries "${libraries} + 1")
            elseif(type STREQUAL "STATIC_LIBRARY" OR type STREQUAL "OBJECT_LIBRARY")
                target_compile_options(${target} PRIVATE ${ANYPS5_PGO_COMPILE_OPTIONS})
                target_link_options(${target} INTERFACE ${ANYPS5_PGO_LINK_OPTIONS})
                math(EXPR libraries "${libraries} + 1")
            endif()
        endforeach()
    endforeach()
    message(STATUS "ANYPS5_PGO=${ANYPS5_PGO}: ${libraries} libraries under core/, the relinker left out")
endfunction()
