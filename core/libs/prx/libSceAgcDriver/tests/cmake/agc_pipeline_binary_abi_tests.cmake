option(ANYPS5_PIPELINE_BINARY_ABI_PROBES "Register the real-device probes that call pipeline binary entry points without the register-preserving call" OFF)

if(BUILD_TESTING AND (MINGW OR CMAKE_SYSTEM_NAME STREQUAL "Linux") AND CMAKE_SYSTEM_PROCESSOR MATCHES "^(x86_64|AMD64|amd64)$")
    enable_language(ASM)
    add_test_executable(agc_pipeline_binary_abi_synthetic_tests
        tests/PipelineBinaryAbiSynthetic.cpp tests/PipelineBinaryAbi.cpp tests/PipelineBinaryAbi.S Graphics/src/PreservedCall.cpp)
    target_include_directories(agc_pipeline_binary_abi_synthetic_tests PRIVATE ${LIBS_INCLUDE_DIR} ${ANYPS5_VULKAN_HEADERS_INCLUDE_DIR})
    configure_host_test_executable(agc_pipeline_binary_abi_synthetic_tests)
    foreach(case conforming clobbering preserved nested)
        add_test(NAME agc_pipeline_binary_abi_synthetic_${case} COMMAND agc_pipeline_binary_abi_synthetic_tests ${case})
        set_tests_properties(agc_pipeline_binary_abi_synthetic_${case} PROPERTIES TIMEOUT 10)
    endforeach()
    add_test_executable(agc_pipeline_binary_abi_tests
        tests/PipelineBinaryAbiVulkan.cpp tests/PipelineBinaryAbi.cpp tests/PipelineBinaryAbi.S Graphics/src/PreservedCall.cpp)
    target_include_directories(agc_pipeline_binary_abi_tests PRIVATE ${LIBS_INCLUDE_DIR} ${ANYPS5_VULKAN_HEADERS_INCLUDE_DIR})
    target_link_libraries(agc_pipeline_binary_abi_tests PRIVATE SDL2-static)
    configure_host_test_executable(agc_pipeline_binary_abi_tests)
    set(agcPipelineBinaryAbiModes preserved)
    if(ANYPS5_PIPELINE_BINARY_ABI_PROBES)
        list(APPEND agcPipelineBinaryAbiModes raw)
    endif()
    foreach(mode IN LISTS agcPipelineBinaryAbiModes)
        add_test(NAME agc_pipeline_binary_abi_${mode} COMMAND agc_pipeline_binary_abi_tests ${mode} 3)
        set_tests_properties(agc_pipeline_binary_abi_${mode} PROPERTIES TIMEOUT 60 SKIP_RETURN_CODE 77
            FAIL_REGULAR_EXPRESSION "VUID-|was not found but was requested by env var VK_INSTANCE_LAYERS")
    endforeach()
endif()
