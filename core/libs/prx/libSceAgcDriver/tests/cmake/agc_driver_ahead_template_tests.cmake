if(BUILD_TESTING)
    foreach(aheadTemplateMode IN ITEMS verify off)
        set(aheadTemplateTest agc_driver_ahead_template_${aheadTemplateMode})
        if(aheadTemplateMode STREQUAL "verify")
            set(aheadTemplateSwitch "APS5_VERIFY_AHEAD_TEMPLATE_BUILD=1")
        else()
            set(aheadTemplateSwitch "APS5_NO_AHEAD_TEMPLATE_BUILD=1")
        endif()
        add_test(NAME ${aheadTemplateTest} COMMAND agc_driver_ahead_template_tests)
        set_tests_properties(${aheadTemplateTest} PROPERTIES ENVIRONMENT "ANYPS5_NO_SHADER_CACHE=1;APS5_FAST_F16=0;APS5_FAST_F32=0;APS5_A2C_FALLBACK=0;APS5_DRAW_PIPELINE=0;APS5_PIPELINE_DISPATCH=0;${aheadTemplateSwitch}" SKIP_RETURN_CODE 77 WORKING_DIRECTORY "${CMAKE_SOURCE_DIR}")
        if(WIN32)
            set_tests_properties(${aheadTemplateTest} PROPERTIES ENVIRONMENT_MODIFICATION
                "PATH=path_list_prepend:$<TARGET_FILE_DIR:libc>")
        endif()
    endforeach()
endif()
