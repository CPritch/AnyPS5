if(BUILD_TESTING)
    set(agcLanesOn "APS5_RESOLVE_LANES=1;APS5_JOB_BINDINGS=1;APS5_PARALLEL_RESOLVE=1")
    foreach(agcLaneMode IN ITEMS "lanes;${agcLanesOn}" "verify;${agcLanesOn};APS5_VERIFY_JOB_BINDINGS=1;APS5_VERIFY_BATCH_KEEPS=1" "verify_resolve;${agcLanesOn};APS5_VERIFY_RESOLVE_SPLIT=1" "shadow;${agcLanesOn};APS5_JOB_BINDINGS_SHADOW=1" "one_lane;" "one_lane_verify;APS5_VERIFY_BATCH_KEEPS=1;APS5_VERIFY_RESOLVE_SPLIT=1" "emit_bindings;APS5_RESOLVE_LANES=1;APS5_PARALLEL_RESOLVE=1" "serial_lanes;APS5_RESOLVE_LANES=1;APS5_JOB_BINDINGS=1" "per_draw_keeps;APS5_NO_BATCH_KEEPS=1;${agcLanesOn}")
        list(GET agcLaneMode 0 agcLaneName)
        list(REMOVE_AT agcLaneMode 0)
        add_test(NAME agc_driver_resolve_lanes_${agcLaneName} COMMAND agc_driver_resolve_lanes_tests)
        set_tests_properties(agc_driver_resolve_lanes_${agcLaneName} PROPERTIES ENVIRONMENT "ANYPS5_NO_SHADER_CACHE=1;APS5_DRAW_PIPELINE=1;APS5_PIPELINED_DRAWS=32;APS5_PIPELINE_DISPATCH=1;APS5_NO_DRAW_RECIPE=1;APS5_RESOLVE_SPLIT_ALL=1;${agcLaneMode}" SKIP_RETURN_CODE 77 WORKING_DIRECTORY "${CMAKE_SOURCE_DIR}")
        if(WIN32)
            set_tests_properties(agc_driver_resolve_lanes_${agcLaneName} PROPERTIES ENVIRONMENT_MODIFICATION "PATH=path_list_prepend:$<TARGET_FILE_DIR:libc>")
        endif()
    endforeach()
endif()
