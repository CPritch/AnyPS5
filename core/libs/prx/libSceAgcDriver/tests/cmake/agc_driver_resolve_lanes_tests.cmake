if(BUILD_TESTING)
    foreach(agcLaneMode IN ITEMS "lanes;" "verify;APS5_VERIFY_JOB_BINDINGS=1;APS5_VERIFY_BATCH_KEEPS=1" "verify_resolve;APS5_VERIFY_RESOLVE_SPLIT=1" "shadow;APS5_JOB_BINDINGS_SHADOW=1" "one_lane;APS5_NO_RESOLVE_LANES=1" "emit_bindings;APS5_NO_JOB_BINDINGS=1" "per_draw_keeps;APS5_NO_BATCH_KEEPS=1")
