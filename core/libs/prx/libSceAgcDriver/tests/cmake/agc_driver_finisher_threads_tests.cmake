if(BUILD_TESTING)
    set_target_properties(agc_driver_finisher_threads_tests PROPERTIES EXCLUDE_FROM_ALL OFF)
    foreach(agcFinisherMode IN ITEMS "default;" "three;APS5_FINISHER_THREADS=3" "one;APS5_NO_FINISHER_THREADS=1")
        list(GET agcFinisherMode 0 agcFinisherName)
        list(REMOVE_AT agcFinisherMode 0)
        add_test(NAME agc_driver_finisher_threads_${agcFinisherName} COMMAND agc_driver_finisher_threads_tests)
        set_tests_properties(agc_driver_finisher_threads_${agcFinisherName} PROPERTIES ENVIRONMENT "APS5_DRAW_PIPELINE=1;${agcFinisherMode}" TIMEOUT 120 WORKING_DIRECTORY "${CMAKE_SOURCE_DIR}")
        if(WIN32)
            set_tests_properties(agc_driver_finisher_threads_${agcFinisherName} PROPERTIES ENVIRONMENT_MODIFICATION "PATH=path_list_prepend:$<TARGET_FILE_DIR:libc>")
        endif()
    endforeach()
endif()
if(BUILD_TESTING)
    foreach(agcFinisherVerified IN ITEMS agc_driver_finisher_label_order agc_driver_resolve_lanes agc_driver_prepare_ahead_device agc_driver_copied_writer_copy agc_driver_depth_storage_reuse)
        add_test(NAME ${agcFinisherVerified}_finisher_verify COMMAND ${agcFinisherVerified}_tests)
        set_tests_properties(${agcFinisherVerified}_finisher_verify PROPERTIES ENVIRONMENT "ANYPS5_NO_SHADER_CACHE=1;APS5_DRAW_PIPELINE=1;APS5_PIPELINED_DRAWS=32;APS5_PIPELINE_DISPATCH=1;APS5_NO_DRAW_RECIPE=1;APS5_RESOLVE_SPLIT_ALL=1;APS5_VERIFY_FINISHER_THREADS=1;APS5_VERIFY_PENDING_WRITE_INDEX=1" SKIP_RETURN_CODE 77 WORKING_DIRECTORY "${CMAKE_SOURCE_DIR}")
        if(WIN32)
            set_tests_properties(${agcFinisherVerified}_finisher_verify PROPERTIES ENVIRONMENT_MODIFICATION "PATH=path_list_prepend:$<TARGET_FILE_DIR:libc>")
        endif()
    endforeach()
endif()
