if(BUILD_TESTING)
    agc_add_draw_pipeline_test(agc_driver_bda_templates)
    set(agcBdaTemplatesEnvironment "ANYPS5_NO_SHADER_CACHE=1;APS5_FAST_F16=0;APS5_FAST_F32=0;APS5_A2C_FALLBACK=0;APS5_DRAW_PIPELINE=0;APS5_PIPELINE_DISPATCH=0")
    set(agcBdaTemplatesPipeline "ANYPS5_NO_SHADER_CACHE=1;APS5_DRAW_PIPELINE=1;APS5_PIPELINED_DRAWS=32;APS5_PIPELINE_DISPATCH=1")
    set(agcBdaTemplatesTests agc_driver_bda_templates agc_driver_bda_templates_draw_pipeline)
    foreach(agcBdaTemplatesCase IN ITEMS plain mirrors verify-drop)
        if(agcBdaTemplatesCase STREQUAL "plain")
            set(agcBdaTemplatesName agc_driver_bda_templates)
            set(agcBdaTemplatesArguments "")
        else()
            string(REPLACE "-" "_" agcBdaTemplatesSuffix "${agcBdaTemplatesCase}")
            set(agcBdaTemplatesName agc_driver_bda_templates_${agcBdaTemplatesSuffix})
            set(agcBdaTemplatesArguments "--${agcBdaTemplatesCase}")
            add_test(NAME ${agcBdaTemplatesName} COMMAND agc_driver_bda_templates_tests ${agcBdaTemplatesArguments})
            set_tests_properties(${agcBdaTemplatesName} PROPERTIES ENVIRONMENT "${agcBdaTemplatesEnvironment}")
            add_test(NAME ${agcBdaTemplatesName}_draw_pipeline COMMAND agc_driver_bda_templates_tests ${agcBdaTemplatesArguments})
            set_tests_properties(${agcBdaTemplatesName}_draw_pipeline PROPERTIES ENVIRONMENT "${agcBdaTemplatesPipeline}")
            list(APPEND agcBdaTemplatesTests ${agcBdaTemplatesName} ${agcBdaTemplatesName}_draw_pipeline)
        endif()
        add_test(NAME ${agcBdaTemplatesName}_off COMMAND agc_driver_bda_templates_tests ${agcBdaTemplatesArguments})
        set_tests_properties(${agcBdaTemplatesName}_off PROPERTIES ENVIRONMENT "${agcBdaTemplatesEnvironment};APS5_NO_BDA_TEMPLATES=1")
        add_test(NAME ${agcBdaTemplatesName}_verify COMMAND agc_driver_bda_templates_tests ${agcBdaTemplatesArguments})
        set_tests_properties(${agcBdaTemplatesName}_verify PROPERTIES ENVIRONMENT "${agcBdaTemplatesEnvironment};APS5_VERIFY_BDA_TEMPLATES=1")
        list(APPEND agcBdaTemplatesTests ${agcBdaTemplatesName}_off ${agcBdaTemplatesName}_verify)
    endforeach()
    set_tests_properties(${agcBdaTemplatesTests} PROPERTIES SKIP_RETURN_CODE 77 TIMEOUT 60 FAIL_REGULAR_EXPRESSION "FATAL:" WORKING_DIRECTORY "${CMAKE_SOURCE_DIR}")
    if(WIN32)
        list(REMOVE_ITEM agcBdaTemplatesTests agc_driver_bda_templates)
        set_tests_properties(${agcBdaTemplatesTests} PROPERTIES ENVIRONMENT_MODIFICATION
            "PATH=path_list_prepend:$<TARGET_FILE_DIR:libc>")
    endif()
endif()
