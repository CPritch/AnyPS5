string(RANDOM LENGTH 16 ALPHABET 0123456789abcdef suffix)
set(root "${ROOT}/pipeline-binary-${MODE}-${suffix}")
foreach(pass capture restore)
    execute_process(COMMAND "${TEST}" --pipeline-binary-restore "${root}" ${MODE} ${pass}
        RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE errors TIMEOUT 60)
    message("${pass}: ${output}${errors}")
    if(result EQUAL 77)
        file(REMOVE_RECURSE "${root}")
        message("skipped, ${output}")
        return()
    endif()
    file(GLOB stores "${root}/driver/binaries/*.bin")
    list(LENGTH stores stored)
    string(REGEX MATCHALL "\\[pipeline-binary\\] saved" saves "${errors}")
    string(REGEX MATCHALL "\\[pipeline-binary\\] loaded" loads "${errors}")
    list(LENGTH saves saved)
    list(LENGTH loads loaded)
    if(NOT result EQUAL 0 OR "${output}${errors}" MATCHES "VUID-")
        file(REMOVE_RECURSE "${root}")
        message(FATAL_ERROR "the ${MODE} ${pass} process failed (${result}) or added Vulkan validation errors")
    endif()
    if(pass STREQUAL "capture" AND (NOT saved EQUAL 1 OR NOT loaded EQUAL 0 OR NOT stored EQUAL 1))
        file(REMOVE_RECURSE "${root}")
        message(FATAL_ERROR "the ${MODE} capture process did not store its compute pipeline: ${saved} saved, ${loaded} loaded, ${stored} files")
    endif()
    if(pass STREQUAL "restore" AND (NOT loaded EQUAL 1 OR NOT saved EQUAL 0 OR errors MATCHES "\\[pipeline-binary\\] built"))
        file(REMOVE_RECURSE "${root}")
        message(FATAL_ERROR "the ${MODE} restore process did not create its compute pipeline from the stored binary: ${loaded} loaded, ${saved} saved")
    endif()
endforeach()
file(REMOVE_RECURSE "${root}")
