string(RANDOM LENGTH 16 ALPHABET 0123456789abcdef suffix)
set(root "${CMAKE_CURRENT_BINARY_DIR}/pipeline-binary-${suffix}")
set(pipelines 3)
foreach(pass capture restore corrupt foreign reload)
    file(GLOB stores "${root}/driver/binaries/*.bin")
    if(pass STREQUAL "corrupt")
        foreach(store IN LISTS stores)
            file(WRITE "${store}" "truncated")
        endforeach()
    elseif(pass STREQUAL "foreign")
        list(LENGTH stores count)
        if(NOT count EQUAL pipelines)
            message(FATAL_ERROR "expected ${pipelines} stored pipelines before the foreign pass, found ${count}")
        endif()
        list(GET stores 0 first)
        file(RENAME "${first}" "${root}/held")
        math(EXPR last "${count} - 1")
        foreach(index RANGE 1 ${last})
            math(EXPR previous "${index} - 1")
            list(GET stores ${index} from)
            list(GET stores ${previous} to)
            file(RENAME "${from}" "${to}")
        endforeach()
        list(GET stores ${last} to)
        file(RENAME "${root}/held" "${to}")
    endif()
    execute_process(COMMAND "${TEST}" --pipeline-binary-only "${root}" ${pass}
        RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE errors TIMEOUT 120)
    message("${pass}: ${output}${errors}")
    if(result EQUAL 77)
        file(REMOVE_RECURSE "${root}")
        message("skipped, no usable Vulkan device or the device lacks VK_KHR_pipeline_binary")
        return()
    endif()
    if(NOT result EQUAL 0)
        file(REMOVE_RECURSE "${root}")
        message(FATAL_ERROR "${pass} failed: ${result}")
    endif()
    if("${output}${errors}" MATCHES "VUID-")
        file(REMOVE_RECURSE "${root}")
        message(FATAL_ERROR "${pass} added Vulkan validation errors")
    endif()
    string(REGEX MATCHALL "\\[pipeline-binary\\] saved" saves "${errors}")
    string(REGEX MATCHALL "\\[pipeline-binary\\] loaded" loads "${errors}")
    string(REGEX MATCHALL "\\[pipeline-binary\\] invalid store" invalid "${errors}")
    list(LENGTH saves saved)
    list(LENGTH loads loaded)
    list(LENGTH invalid rejected)
    if(output MATCHES "pipeline binary policy fallback:")
        if(NOT output MATCHES "ordinary_pipelines=3 cache_saved=1" OR errors MATCHES "\\[pipeline-binary\\] (saved|loaded|built)")
            message(FATAL_ERROR "${pass} did not create ordinary pipelines under the driver gate")
        endif()
        if(NOT pass STREQUAL "capture" AND NOT errors MATCHES "\\[pipeline-cache\\] loaded")
            message(FATAL_ERROR "${pass} did not reuse the ordinary driver pipeline cache")
        endif()
    elseif(pass STREQUAL "restore" OR pass STREQUAL "reload")
        if(NOT loaded EQUAL pipelines OR errors MATCHES "\\[pipeline-binary\\] built")
            file(REMOVE_RECURSE "${root}")
            message(FATAL_ERROR "the ${pass} process did not restore all ${pipelines} pipelines from the store")
        endif()
    elseif(pass STREQUAL "capture")
        if(NOT saved EQUAL pipelines OR NOT loaded EQUAL 0)
            file(REMOVE_RECURSE "${root}")
            message(FATAL_ERROR "the capture process did not persist all ${pipelines} pipelines")
        endif()
    elseif(NOT saved EQUAL pipelines OR NOT rejected EQUAL pipelines OR NOT loaded EQUAL 0)
        file(REMOVE_RECURSE "${root}")
        message(FATAL_ERROR "the ${pass} pass did not reject every entry and rebuild it: ${rejected} rejected, ${saved} saved, ${loaded} loaded")
    endif()
endforeach()
file(REMOVE_RECURSE "${root}")
